# ==============================================================================
# SciStudio v2.0 & Multi-Domain Agentic RAG Platform - Root Environment Example
# ==============================================================================

# Backend Security Configuration (REQUIRED)
# Generate a strong 32+ character random string for production
JWT_SECRET=replace_with_your_strong_random_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection (Dockerized default)
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5433/agentic_rag

# Academic Studio IDE Features (v2.0)
ACADEMIC_STUDIO_ENABLED=true
TECTONIC_BIN_PATH=/usr/local/bin/tectonic
DEFAULT_ACADEMIC_DOMAIN=it

# External Search Provider (Tier 3 Fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# Hardware & LLM Inference Settings
OLLAMA_NUM_GPU=8
CONTEXT_WINDOW=3072
